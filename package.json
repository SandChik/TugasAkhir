    "bcryptjs": "^3.0.3",
    "ethers": "^6.17.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.14",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
