# # Salin ke .env lalu isi nilainya. JANGAN commit .env yang berisi kunci asli.

# # === Autentikasi klien untuk API ini (header X-API-Key) ===
# # Generate dengan: python -c "import secrets; print('be_'+secrets.token_urlsafe(32))"
# API_KEY=

# # === Kunci model 9router (upstream VLM) ===
# # Dipakai endpoint /parse/sk-pembinaan dan /parse/artefak. Server-side saja.
# ROUTER_API_KEY=

# # === CORS ===
# # Daftar origin frontend yang diizinkan, dipisah koma.
# ALLOWED_ORIGINS=http://localhost:3000

# # === Opsional: konfigurasi endpoint VLM ===
# BASE_URL=https://9router.tmfadhli.my.id/v1
# MODEL=ag/gemini-3.5-flash-low
# === Autentikasi klien untuk API ini (header X-API-Key) ===
# Kunci yang WAJIB dikirim klien di header X-API-Key. Di-generate acak.
API_KEY=be_Uup1ik-I3d-UpPIvIrWEmH23bD2sV2AqCezM2kow25w

# === Kunci model 9router (upstream VLM) ===
# Dipakai endpoint /parse/sk-pembinaan dan /parse/artefak. Server-side saja.
ROUTER_API_KEY=sk-dcbf3b5275bd3dc7-asoqv9-5167c005

# === CORS ===
# Daftar origin yang diizinkan, dipisah koma. Jangan pakai "*" untuk produksi.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === Opsional: konfigurasi endpoint VLM ===
BASE_URL=https://9router.tmfadhli.my.id/v1
MODEL=ag/gemini-3.5-flash-low
