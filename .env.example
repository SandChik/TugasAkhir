# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bkd_smart_contract?schema=public"

# --- NextAuth ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Layanan ekstraksi dokumen SK/ST (folder backend-extract, FastAPI) ---
# Dipakai menu admin "Unggah SK & ST". Jalankan layanannya lebih dulu:
#   cd backend-extract && pip install -r requirements.txt && uvicorn api:app --port 8000
PARSER_API_URL=http://localhost:8000
# Samakan dengan API_KEY pada backend-extract/.env (kunci klien, header X-API-Key).
PARSER_API_KEY=
# Batas tunggu satu panggilan parser; endpoint VLM (SK pindai) bisa beberapa menit.
PARSER_TIMEOUT_MS=600000

# --- Blockchain ---
# Dev lokal (hardhat node): NEXT_PUBLIC_CHAIN_ID=31337, RPC_URL=http://127.0.0.1:8545
# Base Sepolia (testnet):   NEXT_PUBLIC_CHAIN_ID=84532, RPC_URL=https://sepolia.base.org (atau RPC provider sendiri)
NEXT_PUBLIC_CHAIN_ID=84352
NEXT_PUBLIC_BKD_CONTRACT_ADDRESS=0xb1Ad6763A8FD2738613E235940Eafc75b920fC22
NEXT_PUBLIC_SKS_TOKEN_ADDRESS=0xa824ee509C23632b54c9436808B71ED46213D288
RPC_URL=https://base-sepolia.drpc.org
# RPC khusus pembacaan event (halaman Log Blockchain). Node publik memangkas log
# lama: publicnode hanya menyimpan sekitar 110.000 block terakhir, jadi mint/burn
# lama terbaca kosong tanpa error. Gateway ini menyimpan log sejak deploy dan
# menerima rentang block penuh sekali panggil, tapi menolak broadcast transaksi,
# karena itu dipisah dari RPC_URL. Kosongkan untuk memakai RPC_URL.
RPC_LOGS_URL=https://base-sepolia.gateway.tenderly.co
# Batas rentang block per eth_getLogs. 0 = tanpa pemecahan (dipakai RPC_LOGS_URL
# di atas). Isi 50000 atau 10000 bila diganti ke provider yang membatasi.
RPC_MAX_BLOCK_RANGE=0
NEXT_PUBLIC_SKS_TOKEN_DEPLOY_BLOCK=44731594
# Registri dokumen on-chain (BKDDokumenRegistri): jejak unggah/terapkan/hapus dokumen.
# Deploy dengan: npx hardhat run scripts/deploy_registri.js --network baseSepolia
NEXT_PUBLIC_DOKUMEN_REGISTRI_ADDRESS=0xdCdeb7969f5680fC960aBF7863a6315C26c187c7
NEXT_PUBLIC_DOKUMEN_REGISTRI_DEPLOY_BLOCK=46031066
# Private key signer backend (MINTER_ROLE + DEFAULT_ADMIN_ROLE pada BKDSKSToken).
# Dipakai juga oleh Hardhat sebagai akun deployer saat deploy ke Base Sepolia.
# Untuk dev lokal: pakai private key akun #0 hardhat node.
# Untuk Base Sepolia: private key wallet yang sudah diisi ETH testnet (lihat SETUP.md), JANGAN commit.
ADMIN_PRIVATE_KEY=

# --- Deploy & verifikasi ke Base Sepolia (testnet, chainId 84532) ---
# RPC publik Base Sepolia: https://sepolia.base.org (bisa diganti provider lain, mis. Alchemy/Infura)
BASE_SEPOLIA_RPC_URL=https://base-sepolia.drpc.org
# API key Etherscan (unified v2, berlaku juga untuk Basescan) untuk `npx hardhat verify`.
# Buat di https://etherscan.io/myapikey
BASESCAN_API_KEY=

# HD mnemonic untuk derivasi wallet custodial dosen (m/44'/60'/0'/0/{wallet_index}).
# Untuk dev lokal: mnemonic default hardhat ("test test ... junk").
# PRODUKSI: WAJIB mnemonic rahasia tersendiri, jangan commit.
WALLET_MNEMONIC="test test test test test test test test test test test junk"
